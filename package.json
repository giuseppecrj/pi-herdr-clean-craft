{
	"name": "pi-herdr-clean-craft",
	"version": "0.0.0",
	"private": true,
	"description": "Unofficial Pi methodology pack inspired by Robert C. Martin's engineering practices. Pre-release: the craft-mode hub and five stage skills ship; specification and final QA stages are planned.",
	"keywords": ["pi-package", "pi", "herdr", "tdd", "refactoring", "clean-code"],
	"license": "MIT",
	"author": {
		"name": "Giuseppe Rodriguez",
		"url": "https://github.com/giuseppecrj"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/giuseppecrj/pi-herdr-clean-craft.git"
	},
	"homepage": "https://github.com/giuseppecrj/pi-herdr-clean-craft#readme",
	"bugs": {
		"url": "https://github.com/giuseppecrj/pi-herdr-clean-craft/issues"
	},
	"type": "module",
	"files": [
		"CHANGELOG.md",
		"LICENSE",
		"README.md",
		"RELEASING.md",
		"THIRD_PARTY_NOTICES.md",
		"docs/compatibility.md",
		"docs/provenance.md",
		"docs/verification.md",
		"skills/craft-mode/SKILL.md",
		"skills/craft-mode/references/authorization.md",
		"skills/craft-mode/references/delegation.md",
		"skills/craft-mode/references/reporting.md",
		"skills/craft-mode/references/workflows.md",
		"skills/craft-tdd/SKILL.md",
		"skills/craft-refactor/SKILL.md",
		"skills/craft-refactor/references/test-quality.md",
		"skills/craft-architecture/SKILL.md",
		"skills/craft-architecture/references/design-principles.md",
		"skills/craft-quality/SKILL.md",
		"skills/craft-quality/references/tool-recipes.md",
		"skills/craft-mutation/SKILL.md",
		"skills/craft-mutation/references/interpretation.md"
	],
	"scripts": {
		"test": "node --test --test-concurrency=1 test/*.test.mjs",
		"test:integration": "node --test --test-concurrency=1 test/integration/*.test.mjs",
		"changelog": "auto-changelog",
		"version": "auto-changelog --package && git add CHANGELOG.md"
	},
	"peerDependencies": {
		"pi-herdr-agents": "3.2.1"
	},
	"devDependencies": {
		"auto-changelog": "^2.6.0"
	},
	"pi": {
		"skills": ["./skills"]
	},
	"publishConfig": {
		"access": "public"
	},
	"auto-changelog": {
		"commitLimit": false,
		"template": "keepachangelog",
		"unreleased": true
	}
}
